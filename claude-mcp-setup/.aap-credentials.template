# AAP Credentials Template
#
# Copy this file to your home directory and fill in your credentials:
#   cp .aap-credentials.template ~/.aap-credentials
#   chmod 600 ~/.aap-credentials
#
# Then edit ~/.aap-credentials with your actual values

# Your AAP instance URL (no trailing slash)
AAP_SERVER=https://your-aap-instance.com

# Your AAP API token (get from AAP UI: Access Management → API Tokens)
AAP_SERVICE_TOKEN=your-token-here

# Optional: Disable SSL verification for demo environments (NOT for production!)
# NODE_TLS_REJECT_UNAUTHORIZED=0
