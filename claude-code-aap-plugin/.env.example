# Ansible Automation Platform Configuration
# Copy this file to .env or add these to your shell profile (~/.zshrc or ~/.bashrc)

# Required: Your AAP instance URL
export AAP_SERVER="https://your-aap-instance.com"

# Required: AAP API token (create one at: Access Management → API Tokens)
export AAP_SERVICE_TOKEN="your-aap-api-token-here"

# Optional: Disable TLS verification for demo environments with self-signed certs
# WARNING: Never use this in production!
# export NODE_TLS_REJECT_UNAUTHORIZED=0

# Optional: Create an alias for easy access from anywhere
# Replace the path with the actual location of this plugin
alias claude-aap='claude --plugin-dir ~/path/to/mcp-demo/claude-code-aap-plugin'
