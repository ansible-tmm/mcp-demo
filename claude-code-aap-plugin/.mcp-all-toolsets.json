{
  "mcpServers": {
    "aap-job-mgmt": {
      "type": "http",
      "url": "${AAP_SERVER}/job_management/mcp",
      "description": "Ansible Automation Platform Job Management",
      "headers": {
        "Authorization": "Bearer ${AAP_SERVICE_TOKEN}"
      },
      "env": {
        "AAP_SERVER": "${AAP_SERVER}",
        "AAP_SERVICE_TOKEN": "${AAP_SERVICE_TOKEN}"
      }
    },
    "aap-inventory": {
      "type": "http",
      "url": "${AAP_SERVER}/inventory_management/mcp",
      "description": "Ansible Automation Platform Inventory Management",
      "headers": {
        "Authorization": "Bearer ${AAP_SERVICE_TOKEN}"
      },
      "env": {
        "AAP_SERVER": "${AAP_SERVER}",
        "AAP_SERVICE_TOKEN": "${AAP_SERVICE_TOKEN}"
      }
    },
    "aap-monitoring": {
      "type": "http",
      "url": "${AAP_SERVER}/system_monitoring/mcp",
      "description": "Ansible Automation Platform System Monitoring",
      "headers": {
        "Authorization": "Bearer ${AAP_SERVICE_TOKEN}"
      },
      "env": {
        "AAP_SERVER": "${AAP_SERVER}",
        "AAP_SERVICE_TOKEN": "${AAP_SERVICE_TOKEN}"
      }
    },
    "aap-user-mgmt": {
      "type": "http",
      "url": "${AAP_SERVER}/user_management/mcp",
      "description": "Ansible Automation Platform User Management",
      "headers": {
        "Authorization": "Bearer ${AAP_SERVICE_TOKEN}"
      },
      "env": {
        "AAP_SERVER": "${AAP_SERVER}",
        "AAP_SERVICE_TOKEN": "${AAP_SERVICE_TOKEN}"
      }
    },
    "aap-security": {
      "type": "http",
      "url": "${AAP_SERVER}/security_compliance/mcp",
      "description": "Ansible Automation Platform Security & Compliance",
      "headers": {
        "Authorization": "Bearer ${AAP_SERVICE_TOKEN}"
      },
      "env": {
        "AAP_SERVER": "${AAP_SERVER}",
        "AAP_SERVICE_TOKEN": "${AAP_SERVICE_TOKEN}"
      }
    },
    "aap-config": {
      "type": "http",
      "url": "${AAP_SERVER}/platform_configuration/mcp",
      "description": "Ansible Automation Platform Platform Configuration",
      "headers": {
        "Authorization": "Bearer ${AAP_SERVICE_TOKEN}"
      },
      "env": {
        "AAP_SERVER": "${AAP_SERVER}",
        "AAP_SERVICE_TOKEN": "${AAP_SERVICE_TOKEN}"
      }
    }
  }
}
